# ── Test harness artifacts ───────────────────────────────────────────────────
# Scratch logs plus the e2e fixture manifest, which carries seeded passwords
# and a signed admin JWT. Regenerated by server/scripts/e2e-stack.js.
server/tmp/
# Generated by `npm run test:coverage`; the committed ratchet lives in
# server/__tests__/support/COVERAGE_FLOOR.json instead.
server/coverage/
# Playwright's generated HTML report, traces and per-run results.
client/playwright-report/
client/test-results/
test-results/
# Saved browser storage state: real session cookies for the seeded test users.
client/e2e/.auth/
