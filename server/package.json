{
  "name": "server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "TZ=UTC jest --runInBand --forceExit",
    "test:tz": "TZ=America/Los_Angeles jest --runInBand --forceExit",
    "test:all": "npm run test && npm run test:tz",
    "test:coverage": "TZ=UTC jest --coverage --runInBand --forceExit --collectCoverageFrom='controllers/**/*.js' --collectCoverageFrom='services/**/*.js' --collectCoverageFrom='routes/**/*.js' --collectCoverageFrom='middleware/**/*.js' --collectCoverageFrom='models/**/*.js' --collectCoverageFrom='authz/**/*.js' --collectCoverageFrom='utils/**/*.js' --collectCoverageFrom='config/**/*.js' --coverageReporters=json-summary --coverageReporters=text-summary && node scripts/check-coverage.js",
    "coverage:record": "node scripts/check-coverage.js --update"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/__tests__/support/"
    ],
    "globalSetup": "<rootDir>/__tests__/support/globalSetup.js",
    "globalTeardown": "<rootDir>/__tests__/support/globalTeardown.js"
  },
  "keywords": [],
  "author": "abhigyan",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@sendgrid/mail": "^8.1.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cfonts": "^3.3.0",
    "cloudinary": "^2.5.1",
    "cls-rtracer": "^2.6.3",
    "compression": "^1.8.1",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cros": "^1.1.0",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "form-data": "^4.0.6",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "^2.35.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.18.0",
    "mongoose": "^8.16.4",
    "morgan": "^1.11.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "prerender-node": "^3.8.3",
    "qrcode-terminal": "^0.12.0",
    "razorpay": "^2.9.6",
    "resend": "^4.8.0",
    "socket.io": "^4.7.2",
    "uuid": "^13.0.0",
    "validator": "^13.15.26",
    "whatsapp-web.js": "^1.34.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "axios": "^1.18.1",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
