PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION
# config/environment.js validateEnvironment() exits at boot if any of these is
# missing when NODE_ENV=production. In development only MONGO_URI is required.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/

# JWT / session secrets — generate strong random values, never reuse across environments
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET encrypts session payloads: it must be STABLE (a changing value
# logs every user out on restart) and SHARED across instances.
JWT_SECRET=your-secure-jwt-secret
SESSION_SECRET=your-secure-session-secret
ADMIN_JWT_SECRET=your-secure-admin-jwt-secret

# Razorpay — dashboard > Settings > API Keys. The SDK cannot be constructed
# without the key pair; webhook signature verification needs the webhook secret,
# which is a DIFFERENT value from the key secret (dashboard > Webhooks).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Cloudinary — media uploads (profile images, doctor verification documents)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Resend — all transactional email (password reset, OTP, booking confirmations).
# Note the variable is named RESEND, not RESEND_API_KEY.
RESEND=re_xxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — the app boots without these, but the related feature is disabled
# ─────────────────────────────────────────────────────────────────────────────

# Google OAuth — Google Cloud Console > Credentials.
# If either is absent, /api/auth/google returns 400 instead of being mounted.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Metered TURN relay for WebRTC. Without it, video calls fall back to public
# STUN only and will silently fail behind symmetric NAT or a strict corporate
# firewall — the endpoint still returns 200, so this failure is easy to miss.
METERED_DOMAIN=your-subdomain.metered.live
METERED_SECRET_KEY=your-metered-api-key

# Gmail SMTP. Used ONLY by the admin password-reset route (a second email path
# alongside Resend, slated for consolidation). Use a Gmail App Password.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Super-admin master login bypass (see server/routes/admin/auth.js).
# Both halves are credentials — never commit real values.
ADMIN_ID=your-admin-email@example.com
ADMIN_PASSWORD=choose-a-strong-password

# First-time admin bootstrap (POST /api/admin/auth/setup). INITIAL_ADMIN_PASSWORD
# is optional; if omitted a random one-time password is generated and logged once.
INITIAL_ADMIN_EMAIL=your-admin-email@example.com
INITIAL_ADMIN_PASSWORD=

# Logging. LOG_LEVEL defaults to 'debug' in development and 'info' in production.
# LOG_VERBOSE=true disables the dev-only suppression of noisy log prefixes.
LOG_LEVEL=debug
LOG_VERBOSE=false
