PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION
# config/environment.js validateEnvironment() exits at boot if any of these is
# missing when NODE_ENV=production. In development only MONGO_URI is required.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/

# JWT / session secrets — generate strong random values, never reuse across environments
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET encrypts session payloads: it must be STABLE (a changing value
# logs every user out on restart) and SHARED across instances.
JWT_SECRET=your-secure-jwt-secret
SESSION_SECRET=your-secure-session-secret
ADMIN_JWT_SECRET=your-secure-admin-jwt-secret

# Razorpay — dashboard > Settings > API Keys. The SDK cannot be constructed
# without the key pair; webhook signature verification needs the webhook secret,
# which is a DIFFERENT value from the key secret (dashboard > Webhooks).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Cloudinary — media uploads (profile images, doctor verification documents)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Resend — all transactional email (password reset, OTP, booking confirmations).
# Note the variable is named RESEND, not RESEND_API_KEY.
RESEND=re_xxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — the app boots without these, but the related feature is disabled
# ─────────────────────────────────────────────────────────────────────────────

# Google OAuth — Google Cloud Console > Credentials.
# If either is absent, /api/auth/google returns 400 instead of being mounted.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# TURN relay for calls: Cloudflare dashboard → Realtime → TURN Server → create
# a key. Without it, calls on mobile data / office Wi-Fi often cannot connect
# (the call screen says "relay unavailable").
CLOUDFLARE_TURN_KEY_ID=your-turn-key-id
CLOUDFLARE_TURN_API_TOKEN=your-turn-key-api-token
# Static relays (no card needed) — used when Cloudflare isn't set up or is
# down. E.g. ExpressTURN's free plan as FALLBACK, a TLS-443 relay as BACKUP.
# TURN_FALLBACK_URLS=turn:relay1.expressturn.com:3478
# TURN_FALLBACK_USERNAME=
# TURN_FALLBACK_CREDENTIAL=
# TURN_BACKUP_URLS=turns:backup.example.com:443?transport=tcp
# TURN_BACKUP_USERNAME=
# TURN_BACKUP_CREDENTIAL=

# Super-admin master login (see server/routes/admin/auth.js).
# Both halves are credentials — never commit real values. The environment is
# the only place this credential lives: rotating ADMIN_PASSWORD takes effect
# on the next login, and the database row never holds a usable copy.
ADMIN_ID=your-admin-email@example.com
ADMIN_PASSWORD=choose-a-strong-password

# First-time admin bootstrap (POST /api/admin/auth/setup). Both are required
# for setup to run; nothing is generated or logged.
INITIAL_ADMIN_EMAIL=your-admin-email@example.com
INITIAL_ADMIN_PASSWORD=

# Logging. LOG_LEVEL defaults to 'debug' in development and 'info' in production.
# LOG_VERBOSE=true disables the dev-only suppression of noisy log prefixes.
LOG_LEVEL=debug
LOG_VERBOSE=false
