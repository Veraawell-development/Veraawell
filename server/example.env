PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Google OAuth — from Google Cloud Console > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/

# Gmail SMTP for transactional email (use a Gmail App Password, not your account password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Super-admin master login bypass (see server/routes/admin/auth.js)
ADMIN_ID=your-admin-email@example.com
ADMIN_PASSWORD=choose-a-strong-password

# JWT / session secrets — generate strong random values, do not reuse across environments
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=your-secure-jwt-secret
SESSION_SECRET=your-secure-session-secret
ADMIN_JWT_SECRET=your-secure-admin-jwt-secret

# First-time admin bootstrap (see POST /api/admin/auth/setup) — INITIAL_ADMIN_PASSWORD
# is optional; if omitted, a random one-time password is generated and logged once.
INITIAL_ADMIN_EMAIL=your-admin-email@example.com
INITIAL_ADMIN_PASSWORD=
