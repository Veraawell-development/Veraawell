   "updated": 1,
   "link": null,
   "locked": false,
   "text": "OUR API on Render (FREE tier)\nSocket.IO signalling + call rooms kept in memory\n\u2022 sleeps when idle \u2192 30\u201360 s cold start\n\u2022 any restart/deploy wipes every room\n\u2022 ~0.1 CPU",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "3may96v3unghnpyf",
   "originalText": "OUR API on Render (FREE tier)\nSocket.IO signalling + call rooms kept in memory\n\u2022 sleeps when idle \u2192 30\u201360 s cold start\n\u2022 any restart/deploy wipes every room\n\u2022 ~0.1 CPU",
   "autoResize": true,
   "lineHeight": 1.25
  },
