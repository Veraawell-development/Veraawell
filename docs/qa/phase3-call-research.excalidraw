   "seed": 1077553420,
   "version": 1,
   "versionNonce": 1184086816,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. VOICE SESSIONS HAVE NO SOUND. In voice mode the screen has no element to play the other person's audio \u2014 the\ncall 'connects', shows 'Speaking\u2026', nobody hears anything. Confirmed in code; true since the first version.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "4gawdortvnzl8ey6",
   "originalText": "1. VOICE SESSIONS HAVE NO SOUND. In voice mode the screen has no element to play the other person's audio \u2014 the\ncall 'connects', shows 'Speaking\u2026', nobody hears anything. Confirmed in code; true since the first version.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "v98607g2e9cyky4k",
