  },
  {
   "id": "c7g3jphd03hndw7j",
   "type": "text",
   "x": 1828,
   "y": 601.5,
   "width": 864,
   "height": 52,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1902086882,
   "version": 1,
   "versionNonce": 600343018,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "3. Any network blip ends the call. A 1-second socket drop = 'the other person left' instantly; the video is\nblanked and the call rebuilt. Only the doctor's side retries; the patient's side reuses a dead connection \u2192\nstuck.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "pck0yduzdueo14qp",
   "originalText": "3. Any network blip ends the call. A 1-second socket drop = 'the other person left' instantly; the video is\nblanked and the call rebuilt. Only the doctor's side retries; the patient's side reuses a dead connection \u2192\nstuck.",
   "autoResize": true,
   "lineHeight": 1.25
  },
