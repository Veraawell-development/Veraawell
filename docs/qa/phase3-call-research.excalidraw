   "versionNonce": 1195239510,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "4. Camera/mic problem = never joins. Permission denied, camera busy (Zoom/Teams), no webcam, or a link opened\ninside WhatsApp/Gmail \u2192 that person never enters the room; the other waits forever. No audio-only fallback, no\nretry, no device picker.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "03q0x7isip4h6t6w",
   "originalText": "4. Camera/mic problem = never joins. Permission denied, camera busy (Zoom/Teams), no webcam, or a link opened\ninside WhatsApp/Gmail \u2192 that person never enters the room; the other waits forever. No audio-only fallback, no\nretry, no device picker.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
