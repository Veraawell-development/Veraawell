   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "5. Free hosting. Server sleeps (30\u201360 s first join), restarts wipe every live room, a crash ends every call. A\ndatabase hiccup is shown as 'session expired' and sends people to the login page.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "efk9px44wnvv5ieh",
   "originalText": "5. Free hosting. Server sleeps (30\u201360 s first join), restarts wipe every live room, a crash ends every call. A\ndatabase hiccup is shown as 'session expired' and sends people to the login page.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
