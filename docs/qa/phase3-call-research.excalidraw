   "updated": 1,
   "link": null,
   "locked": false,
   "text": "12. Security. Other websites could open a signed-in user's live connection (no origin check on the socket); the\npatient-only 'ready' signal isn't role-checked; cancelled sessions aren't kicked from the call.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "eigz3h2ay4psh3an",
   "originalText": "12. Security. Other websites could open a signed-in user's live connection (no origin check on the socket); the\npatient-only 'ready' signal isn't role-checked; cancelled sessions aren't kicked from the call.",
   "autoResize": true,
   "lineHeight": 1.25
  },
