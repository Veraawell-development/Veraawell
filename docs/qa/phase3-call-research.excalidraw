   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "8. Double offers / stale connection data. Both joining at the same moment, or two tabs, make two offers and\nleave the doctor waiting for an answer forever.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "po57v3zwvvi558ec",
   "originalText": "8. Double offers / stale connection data. Both joining at the same moment, or two tabs, make two offers and\nleave the doctor waiting for an answer forever.",
   "autoResize": true,
   "lineHeight": 1.25
  },
