   "updated": 1,
   "link": null,
   "locked": false,
   "text": "10. Timer surprises. Jumps up when a late doctor joins (by rule, but unexplained); counts down while you wait\nalone; stuck at 00:00 if the connection is down; confusing error after the end.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "5zv9f4ozdniy77rd",
   "originalText": "10. Timer surprises. Jumps up when a late doctor joins (by rule, but unexplained); counts down while you wait\nalone; stuck at 00:00 if the connection is down; confusing error after the end.",
   "autoResize": true,
   "lineHeight": 1.25
  },
