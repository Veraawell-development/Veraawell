  {
   "id": "nlksgdi3eguz316w",
   "type": "text",
   "x": 428,
   "y": 411.0,
   "width": 1284,
   "height": 38,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1602683975,
   "version": 1,
   "versionNonce": 56891155,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Video & audio go DIRECTLY between the two browsers. On strict / mobile / office networks that only works through a TURN relay \u2014 so when TURN is missing,\nboth people are 'joined' and nobody sees or hears anyone.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "6v6me4gbc964jmlh",
   "originalText": "Video & audio go DIRECTLY between the two browsers. On strict / mobile / office networks that only works through a TURN relay \u2014 so when TURN is missing,\nboth people are 'joined' and nobody sees or hears anyone.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
