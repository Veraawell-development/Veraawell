   "versionNonce": 60183079,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "2. No relay = no call. TURN can silently fail (seen in our logs) \u2192 falls back to STUN only \u2192 calls never\nconnect on Jio/Airtel mobile data, office Wi-Fi, many home routers.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "v98607g2e9cyky4k",
   "originalText": "2. No relay = no call. TURN can silently fail (seen in our logs) \u2192 falls back to STUN only \u2192 calls never\nconnect on Jio/Airtel mobile data, office Wi-Fi, many home routers.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "pck0yduzdueo14qp",
   "type": "rectangle",
   "x": 1820,
   "y": 565,
