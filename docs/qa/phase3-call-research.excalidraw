  {
   "id": "58d150s7ztx7s4r9",
   "type": "text",
   "x": 918,
   "y": 610.0,
   "width": 864,
   "height": 35,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
