   "updated": 1,
   "link": null,
   "locked": false,
   "text": "9. Misleading screen. 'Connected' shown before media flows; a stale 'camera is off' over live video; video can\nstay black if autoplay is blocked (no 'tap to play').",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "ny17srd4thtjld3b",
   "originalText": "9. Misleading screen. 'Connected' shown before media flows; a stale 'camera is off' over live video; video can\nstay black if autoplay is blocked (no 'tap to play').",
   "autoResize": true,
   "lineHeight": 1.25
  },
