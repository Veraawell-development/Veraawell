   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "2. What breaks \u2014 the main issues, ranked (from reading every line of the call code, client + server)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "cml03xxzmkg6aufz",
   "originalText": "2. What breaks \u2014 the main issues, ranked (from reading every line of the call code, client + server)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "4gawdortvnzl8ey6",
