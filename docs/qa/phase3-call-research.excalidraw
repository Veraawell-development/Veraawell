   "locked": false,
   "text": "7. Check-in tab blocks the call. Opening the patient's 'Quick Check-in' silently stops the call from starting;\nthe doctor sees a black screen with no explanation.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "zymxy8jllf3sbo7d",
   "originalText": "7. Check-in tab blocks the call. Opening the patient's 'Quick Check-in' silently stops the call from starting;\nthe doctor sees a black screen with no explanation.",
   "autoResize": true,
   "lineHeight": 1.25
  },
