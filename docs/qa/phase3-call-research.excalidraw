   "updated": 1,
   "link": null,
   "locked": false,
   "text": "11. Rules side-effects. A network blip counts as 'absent' (feeds the 10-minute refund rule and blocks 'End by\nagreement'); after a restart, people in a call can be marked absent.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "njifwr7g43f86tbm",
   "originalText": "11. Rules side-effects. A network blip counts as 'absent' (feeds the 10-minute refund rule and blocks 'End by\nagreement'); after a restart, people in a call can be marked absent.",
   "autoResize": true,
   "lineHeight": 1.25
  },
