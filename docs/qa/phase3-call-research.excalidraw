   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "6. Rejoining loses messages. After a reconnect, call messages arrive before the re-join finishes (6\u20139 database\nsteps) and are rejected \u2192 red 'not a participant' error, no retry.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "153taetnft5usjow",
   "originalText": "6. Rejoining loses messages. After a reconnect, call messages arrive before the re-join finishes (6\u20139 database\nsteps) and are rejected \u2192 red 'not a participant' error, no retry.",
   "autoResize": true,
   "lineHeight": 1.25
  },
